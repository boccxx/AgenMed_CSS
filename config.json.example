{
  "openai_api_key": "your-api-key-here",
  "api_base": "https://openrouter.ai/api/v1/",
  "model": "openai/gpt-5",
  "sub_prompt_model": "openai/gpt-5",
  "meta_prompt_path": "./templates/prompts/meta_prompt.md",
  "input_dir": ".",
  "output_dir": "./output",
  "temp_dir": "./temp",
  "r_scripts_dir": "./r_scripts",
  "log_dir": "./Log",
  "max_retries": 10,
  "timeout": 800,
  "r_executable": "Rscript",
  "max_tokens": 40000,
  "temperature": 0.1
}



